# Déjala vacía en Vercel: vercel.json reenvía /api al servidor de Render (mismo dominio, la cookie de sesión funciona en todos los navegadores).
# Solo ponla si quieres llamar al API directo, p. ej. VITE_API_URL=https://mimatricula-api.onrender.com
VITE_API_URL=
# Portal de matrícula simulado. Por defecto: localhost:5174 en desarrollo y https://mimatricula-portal.vercel.app/ en producción.
VITE_PORTAL_URL=
