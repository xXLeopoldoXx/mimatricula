{
  "name": "mimatricula",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter portal-mock dev",
    "dev:portal": "pnpm --filter portal-mock dev",
    "dev:web": "pnpm --filter web dev",
    "dev:ext": "pnpm --filter extension dev",
    "build": "pnpm -r build",
    "build:ext": "pnpm --filter extension build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "gen:data": "pnpm --filter @mimatricula/demo-data gen"
  }
}
